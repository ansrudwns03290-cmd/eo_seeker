{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (Ninja/MSVC)",
            "inherits": "base",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "VCPKG_ROOT": "C:/vcpkg",
                "VCPKG_BINARY_SOURCES": "clear;files,C:/vcpkg-cache,readwrite"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_HOST_TRIPLET": "x64-windows",
                "VCPKG_BUILD_TYPE": "debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (Ninja/MSVC)",
            "inherits": "base",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "VCPKG_ROOT": "C:/vcpkg",
                "VCPKG_BINARY_SOURCES": "clear;files,C:/vcpkg-cache,readwrite"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_HOST_TRIPLET": "x64-windows",
                "VCPKG_BUILD_TYPE": "release",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "pi-debug",
            "displayName": "Raspberry Pi Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
        },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "RASPBERRY_PI_BUILD": "ON"
            }
        },
        {
            "name": "pi-release",
            "displayName": "Raspberry Pi Release",
            "inherits": "pi-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-debug", "configurePreset": "windows-debug" },
        { "name": "windows-release", "configurePreset": "windows-release" },
        { "name": "pi-debug", "configurePreset": "pi-debug" },
        { "name": "pi-release", "configurePreset": "pi-release" }
    ]
}
