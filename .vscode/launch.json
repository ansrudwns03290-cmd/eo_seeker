{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "eo_seeker 디버그 (CMake Tools 타겟)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "preLaunchTask": "CMake: build",
            "args": ["data/test1.mp4"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "gdb 예쁜 출력 활성화",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
