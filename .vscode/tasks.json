{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenCV with MSVC x64",
            "type": "shell",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Tools\\MSVC\\14.44.35207\\bin\\Hostx64\\x64\\cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "/std:c++17",
                "/Zi",
                "/I", "include",
                // install 폴더 내의 include 하나면 충분합니다.
                "/I", "C:/opencv_build/build/install/include",
                
                "src/main.cpp",
                "src/input/VideoInput.cpp",
                "src/preprocessing/Preprocessor.cpp",
                "src/acquisition/AcquisitionManager.cpp",
                "src/target_tracking/tracker.cpp", 
                
                "/link",
                // 라이브러리 경로도 install 폴더 내부를 가리킵니다.
                "/LIBPATH:C:/opencv_build/build/install/x64/vc17/lib",
                
                "opencv_core4140.lib",
                "opencv_imgproc4140.lib",
                "opencv_videoio4140.lib",
                "opencv_highgui4140.lib",
                "opencv_features2d4140.lib",
                "opencv_tracking4140.lib",
                "opencv_video4140.lib",
                "opencv_imgcodecs4140.lib",
                
                "/MACHINE:X64",
                "/OUT:build/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        }
    ]
}